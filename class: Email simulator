class Email:
    def __init__(self, sender, receiver, subject, body):
        self.sender=sender
        self.receiver=receiver
        self.subject=subject
        self.body=body
        self.read=False

    def mark_as_read(self):
        self.read=True

    def display_full_email(self):
        print(f"\n From: {self.sender.name}")
        print(f"\n To: {self.receiver.name}")
        print(f"\n Subject: {self.subject}")
        print(f"\n Body: {self.body}")

    def __str__(self):
        if self.read==True:
            status="Read"
        else:
            status="Unread"
        return f"[{status}: From: {self.sender.name} | Subject: [{self.subject}]]"

class User:
    def __init__(self, name):
        self.name=name
        self.inbox=Inbox()

    def send_email(self, receiver, subject, body):
        email=Email(sender=self, receiver=receiver, subject=subject, body=body)
        receiver.inbox.receive_email(email)
        print("Email sent.")

    def see_email(self, index):
        self.inbox.see_email(index)

    def delete_email(self, index):
        self.inbox.delete_email(index)

    def check_inbox(self):
        if not self.inbox.email_list:
            print("Inbox empty")
            return
        self.inbox.check_inbox()

class Inbox:
    def __init__(self):
        self.email_list=[]

    def check_inbox(self):
        for i, email in enumerate(self.email_list, start=1):
            print(f" {i} | {email}")

    def receive_email(self, email):
        self.email_list.append(email)

    def delete_email(self, index):
        real_index=index-1
        if not self.email_list:
            print("No messages found.")
            return
        del self.email_list[real_index]
        print("Email deleted.")

    def see_email(self, index):
        real_index=index-1
        if not real_index<0 and not real_index>=len(self.email_list):
            self.email_list[real_index].display_full_email()
        else: 
            print("Wrong index.")

def main():
    ram=User("Ram")
    shyam=User("Shyam")
    ram.send_email(shyam, "Haan bhai", "Ke haal hai...")
    shyam.send_email(ram, "Majaa ma", "Zindagi ke maje le rahe hain..tum sunao")
    ram.check_inbox()
    ram.see_email(1)
    ram.delete_email(1)
    ram.check_inbox()

main()
